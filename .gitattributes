# Normalize line endings so the repo is identical on every platform.
# Text files are stored with LF; Windows checkouts may convert on checkout,
# but the committed bytes stay LF.
* text=auto eol=lf

# Explicit text types
*.js    text
*.mjs   text
*.cjs   text
*.json  text
*.md    text
*.yml   text
*.yaml  text
*.html  text
*.css   text
*.svg   text

# Binary: never touch these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary

# Keep the generated bundle out of diffs' noise but still track it
lib/client.js linguist-generated=true
